/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Hashed filenames, so these are safe to pin for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short and revalidated: a redeploy must be visible in minutes, not tomorrow.
# See the fleet note about stale-while-revalidate serving the old copy on the
# first load after expiry as well as before it.
/index.html
  Cache-Control: public, max-age=600, must-revalidate

# The worker is the one file that must never be served stale: a cached sw.js
# is a cached update mechanism, and the app would stop being able to replace
# itself. Build output it caches is content-hashed and immutable above, and
# everything else it holds is only a fallback for when there is no network, so
# nothing is lost by revalidating this one small file every time.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
